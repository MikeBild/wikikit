{
  "name": "wikikit",
  "version": "0.26.0",
  "description": "Headless AI-native knowledge system for humans and agents — Markdown-first knowledge in, structured and agent-ready knowledge out",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun --watch bin/wikikit.ts",
    "start": "bun bin/wikikit.ts",
    "migrate": "bun bin/wikikit.ts --migrate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cockpit/tsconfig.json",
    "gate": "bun scripts/gate.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "test": "bun test test/unit test/contract",
    "test:unit": "bun test test/unit",
    "test:contract": "bun test test/contract",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "bench": "bun benchmarks/index.ts",
    "build:binary": "bash build-binary.sh",
    "gen:migrations": "bun scripts/gen-embedded-migrations.ts",
    "dev:cockpit": "vite --config apps/cockpit/vite.config.ts",
    "build:cockpit": "vite build --config apps/cockpit/vite.config.ts && bun scripts/gen-embedded-cockpit.ts",
    "gen:cockpit": "bun scripts/gen-embedded-cockpit.ts",
    "gen:cockpit-types": "openapi-typescript docs/openapi.json -o apps/cockpit/src/api/schema.d.ts",
    "check:cockpit-drift": "bun run gen:cockpit-types && bun run build:cockpit && git diff --exit-code apps/cockpit/src/api/schema.d.ts assets/cockpit src/cockpit-embedded.ts",
    "check:cockpit-browser": "bun scripts/check-cockpit-browser.ts",
    "verify:cockpit-loop": "bun scripts/deploy/verify-cockpit-loop.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/openai": "^4.0.20",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.37",
    "exceljs": "^4.4.0",
    "jose": "^6.2.4",
    "mammoth": "^1.12.0",
    "openid-client": "^6.8.4",
    "pg": "^8.16.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unpdf": "^1.6.2",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@types/bun": "^1.2.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.0.0",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "author": "Mike Bild <mike@mikebild.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeBild/wikikit.git"
  },
  "homepage": "https://github.com/MikeBild/wikikit#readme",
  "bugs": {
    "url": "https://github.com/MikeBild/wikikit/issues"
  },
  "keywords": [
    "knowledge-base",
    "wiki",
    "ai-native",
    "headless",
    "mcp",
    "api-first",
    "markdown",
    "okf",
    "claims",
    "agents"
  ]
}

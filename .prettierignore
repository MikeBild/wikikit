# Byte-exact test material — fixture bodies are content-hashed (their sha256
# is load-bearing: sources/<hash>.md stems must equal sha256(body)) and
# foreign-bundle fixtures mirror external tooling output. Reformatting them
# silently breaks round-trip and conformance tests.
test/fixtures/

# Vendored upstream specification — verbatim by contract, never reformatted.
docs/okf-v0.1.md

# Product-family convention — copied byte-for-byte from the reviewed v1.4
# handoff so the repository cannot silently reinterpret the shared rules. The
# root copy is the shared document itself, identical in all six repositories;
# reformatting it here would make this repository's copy differ from the other
# five and turn "the same file everywhere" into five diffs nobody chose.
COCKPIT-KONVENTION.md
apps/cockpit/COCKPIT-CONVENTION.md

# Generated cockpit artifacts. Both are committed and drift-checked by
# rebuilding them, so a formatter that touched either would make every build
# report drift it did not cause.
assets/cockpit/
src/cockpit-embedded.ts

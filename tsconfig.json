{
  // WHY: Bun runs TypeScript natively — there is no build step for dev, so the
  // compiler is used exclusively as a type checker (noEmit). Module settings
  // mirror Bun's runtime semantics (ESM + bundler-style resolution) so what
  // typechecks is exactly what runs.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,

    // Strictness: zod guards the boundaries at runtime; the compiler guards
    // everything else. All strict-family flags on, no implicit escape hatches.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "types": ["bun"],

    // The cockpit's own alias, so the unit tests that hold its pure modules
    // against the server's (scope implication, the navigation table, the diff)
    // can import them by the same path the console does.
    //
    // Note what this does NOT do: `lib` stays ES2023 with no DOM, so only a
    // genuinely browser-free module resolves here. A cockpit module that
    // reaches for `localStorage` or `window` fails to typecheck the moment a
    // test imports it — which is the pressure that keeps the rules pure and
    // testable rather than tangled into the view.
    "baseUrl": ".",
    "paths": { "@/*": ["./apps/cockpit/src/*"] }
  },
  "include": ["bin", "src", "scripts", "test"],
  "exclude": ["node_modules", "dist"]
}

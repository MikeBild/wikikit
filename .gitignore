# Dependencies
node_modules/

# Build output (single-binary compile target)
dist/

# Local environment overrides — secrets never enter the repo.
# .env.defaults and .env.example ARE committed (dev defaults / documentation).
.env
*.local

# Local dev stack state (Docker postgres data dir, bootstrap key cache)
.wikikit-local/

# Editor/OS noise
.DS_Store

# NOTE: the generated artifacts are deliberately NOT ignored — they are
# committed and guarded by drift tests, because a generated file that is not
# drift-checked is a generated file that is stale:
#   src/db/migrations/embedded.ts   `bun run gen:migrations`
#   src/cockpit-embedded.ts         `bun run build:cockpit`
#   assets/cockpit/                 `bun run build:cockpit`

# Planning docs — never committed
docs/plans/
